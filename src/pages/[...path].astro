---
import { getPageBySlug, getSlugFromPathname } from "@config/site-pages";
import StoryblokPage from "../components/StoryblokPage.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchStoryblokStory } from "../utils/storyblok-cdn";

const slug = getSlugFromPathname(Astro.url.pathname);

if (!slug || slug === "home") {
    return Astro.redirect("/");
}

const page = getPageBySlug(slug);

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Not Found",
    });
}

const hostname = Astro.request.headers.get("host")?.split(":")[0];
const story = await fetchStoryblokStory(slug, { hostname: hostname ?? undefined });
---

<BaseLayout title={story?.name || page.title}>
    <StoryblokPage
        client:load
        slug={slug}
        title={page.title}
        pathname={Astro.url.pathname}
        initialStory={story}
    />
</BaseLayout>
