# Storyblok
PUBLIC_STORYBLOK_ACCESS_TOKEN=your-preview-or-public-token
PUBLIC_STORYBLOK_SPACE_ID=your-space-id
PUBLIC_STORYBLOK_VERSION=draft
PUBLIC_STORYBLOK_REGION=

# Dev-only: auto-sync plain localhost tabs when Storyblok content changes (default: on)
# PUBLIC_STORYBLOK_DEV_AUTO_SYNC=false
# PUBLIC_STORYBLOK_DEV_POLL_MS=1000

# Netlify branch deploy only — fetch draft from CDN without rebuild (do not set locally)
# PUBLIC_STORYBLOK_LIVE_PREVIEW=true
# PUBLIC_STORYBLOK_LIVE_PREVIEW_POLL_MS=3000

# Visual Editor live typing: "0" is fastest; use "url" if link fields must resolve in preview
# PUBLIC_STORYBLOK_BRIDGE_RESOLVE_LINKS=0

# Site
PUBLIC_SITE_URL=https://localhost:3000
PUBLIC_SITE_TITLE=APCON
PUBLIC_SITE_DESCRIPTION=APCON website powered by Storyblok

# Cloudinary
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_API_KEY=

# Google Tag Manager
# PUBLIC_GTM_ID=

# OneTrust
# PUBLIC_ONETRUST_DOMAIN_SCRIPT=

# HubSpot
# PUBLIC_HUBSPOT_PORTAL_ID=

# Optional: webhook rebuilds (not needed for live CDN preview)
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/...
# NETLIFY_BUILD_HOOK_BRANCH=dev
# STORYBLOK_WEBHOOK_SECRET=choose-a-random-secret

# Nuxt/Gatsby fallbacks (optional — Astro reads PUBLIC_* first)
# NUXT_PUBLIC_STORYBLOK_ACCESS_TOKEN=
# GATSBY_STORYBLOK_ACCESS_TOKEN=
